# Configuración de producción para AWS EC2.
# Copia este archivo como .env en EC2 y reemplaza los valores de ejemplo.

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=REEMPLAZAR_CON_UNA_CLAVE_SECRETA_LARGA
DJANGO_ALLOWED_HOSTS=IP_ELASTICA_O_DOMINIO

SGR_DB_NAME=sgr_db
SGR_DB_USER=sgr_app
SGR_DB_PASSWORD=REEMPLAZAR_CON_CONTRASENA_MYSQL_SEGURA
SGR_DB_HOST=127.0.0.1
SGR_DB_PORT=3306